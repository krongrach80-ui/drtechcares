{
  "name": "drtechcares-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/copy-wasm.mjs && tsc --noEmit && vite build && node scripts/build-worker.mjs && node scripts/strip-models.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "vitest run",
    "predev": "node scripts/copy-wasm.mjs",
    "api:dev": "node --experimental-strip-types apps/api/src/index.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^14.13.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.475.0",
    "onnxruntime-web": "^1.21.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.0.0"
  }
}
