# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Host w600k_r50.onnx (166 MB) on R2 / CDN for production, or leave default for local dev & automatic hybrid-512d fallback
VITE_ARCFACE_MODEL_URL=/models/w600k_r50.onnx
# Optional CDN path for onnxruntime-web WASM binaries (e.g. https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/)
VITE_ORT_WASM_PATHS=

# Backend API / Cloudflare Worker
PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=production
BIOMETRIC_GATE_MODE=strict-multi-subband

# Optional local model cache directory for scripts/copy-wasm.mjs
DRTECH_MODEL_CACHE_DIR=

